Save.Font=Enum.Font.GothamBold
Save.TextSize=13
Instance.new("UICorner",Save).CornerRadius=UDim.new(0,8)

-- ĐI ĐẾN VỊ TRÍ ĐÃ LƯU
local Go=Instance.new("TextButton",F)
Go.Position=UDim2.new(0,8,0,96)
Go.Size=UDim2.new(1,-16,0,38)
Go.BackgroundColor3=Green2
Go.Text="▶ ĐI ĐẾN VỊ TRÍ ĐÃ LƯU"
Go.TextColor3=Color3.new(1,1,1)
Go.Font=Enum.Font.GothamBold
Go.TextSize=13
Instance.new("UICorner",Go).CornerRadius=UDim.new(0,8)

-- XÓA VỊ TRÍ
local Clear=Instance.new("TextButton",F)
Clear.Position=UDim2.new(0,8,0,140)
Clear.Size=UDim2.new(1,-16,0,32)
Clear.BackgroundColor3=Color3.fromRGB(50,70,50)
Clear.Text="✕ XÓA VỊ TRÍ"
