Clear.Font=Enum.Font.GothamBold
Clear.TextSize=12
Instance.new("UICorner",Clear).CornerRadius=UDim.new(0,8)

-- SCROLL
local List=Instance.new("ScrollingFrame",F)
List.Position=UDim2.new(0,5,0,180)
List.Size=UDim2.new(1,-10,1,-185)
List.BackgroundTransparency=1
List.BorderSizePixel=0
List.ScrollBarThickness=5
List.ScrollBarImageColor3=Yellow
List.CanvasSize=UDim2.new(0,0,0,0)

local Layout=Instance.new("UIListLayout",List)
Layout.Padding=UDim.new(0,5)

-- KÉO GUI
local dragging=false
local dragStart
local startPos

T.InputBegan:Connect(function(i)
if i.UserInputType==Enum.UserInputType.MouseButton1
or i.UserInputType==Enum.UserInputType.Touch then
dragging=true
dragStart=i.Position
startPos=F.Position
end
end)

UIS.InputChanged:Connect(function(i)
if dragging and (i.UserInputType==Enum.UserInputType.MouseMovement
or i.UserInputType==Enum.UserInputType.Touch) then
local d=i.Position-dragStart
F.Position=UDim2.new(
startPos.X.Scale,startPos.X.Offset+d.X,
startPos.Y.Scale,startPos.Y.Offset+d.Y
)
end
end)

UIS.InputEnded:Connect(function(i)
if i.UserInputType==Enum.UserInputType.MouseButton1
or i.UserInputType==Enum.UserInputType.Touch then
dragging=false
end
end)

-- MỤC TIÊU PLAYER
local Target=nil
local Following=false

-- VỊ TRÍ ĐÃ LƯU
local SavedPosition=nil
local GoingToSaved=false

-- LƯU VỊ TRÍ HIỆN TẠI
Save.MouseButton1Click:Connect(function()
local c=M.Character
local r=c and c:FindFirstChild("HumanoidRootPart")

if r then
	SavedPosition=r.Position
	Save.Text="✓ ĐÃ LƯU VỊ TRÍ"

	task.delay(1.5,function()
		if Save then
			Save.Text="📍 LƯU VỊ TRÍ HIỆN TẠI"
		end
	end)
end

end)

-- ĐI ĐẾN VỊ TRÍ ĐÃ LƯU
Go.MouseButton1Click:Connect(function()
if SavedPosition then
Following=false
GoingToSaved=true
end
end)

-- XÓA VỊ TRÍ
Clear.MouseButton1Click:Connect(function()
SavedPosition=nil
GoingToSaved=false
Following=false
Clear.Text="✓ ĐÃ XÓA"

task.delay(1,function()
	if Clear then
		Clear.Text="✕ XÓA VỊ TRÍ"
	end
end)

end)

-- TẠO PLAYER BUTTON
local function AddPlayer(p)
if p==M then return end

local B=Instance.new("TextButton",List)
B.Size=UDim2.new(1,-5,0,38)
B.BackgroundColor3=Green2
B.Text="→ "..p.Name
B.TextColor3=Color3.new(1,1,1)
B.TextSize=15
B.Font=Enum.Font.GothamBold

Instance.new("UICorner",B).CornerRadius=UDim.new(0,8)

B.MouseButton1Click:Connect(function()
	Target=p
	Following=true
	GoingToSaved=false
end)

end

for _,p in ipairs(P:GetPlayers()) do
AddPlayer(p)
end

P.PlayerAdded:Connect(AddPlayer)

Layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
List.CanvasSize=UDim2.new(
0,0,0,
Layout.AbsoluteContentSize.Y+5
)
end)

-- DI CHUYỂN LIÊN TỤC
task.spawn(function()
while task.wait(.1) do
local c=M.Character
local h=c and c:FindFirstChildOfClass("Humanoid")

	if h then
		if GoingToSaved and SavedPosition then
			h:MoveTo(SavedPosition)

		elseif Following and Target and Target.Parent then
			local t=Target.Character
			local r=t and t:FindFirstChild("HumanoidRootPart")

			if r then
				h:MoveTo(r.Position)
			end
		end
	end
end

end)

-- SAU KHI HỒI SINH
M.CharacterAdded:Connect(function()
if SavedPosition and GoingToSaved then
task.wait(1)
end
end)

-- ON/OFF
local on=true

Toggle.MouseButton1Click:Connect(function()
on=not on
F.Visible=on

if not on then
	Toggle.Text="OFF"
	Toggle.BackgroundColor3=Color3.fromRGB(70,70,70)
	Following=false
	GoingToSaved=false
else
	Toggle.Text="ON"
	Toggle.BackgroundColor3=Green
end

end)

-- PLAYER RỜI SERVER
P.PlayerRemoving:Connect(function(p)
if Target==p then
Target=nil
Following=false
end
end)
